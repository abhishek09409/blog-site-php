APP_ENV=production
APP_DEBUG=false
# Use the real address. If the site lives in a subfolder, include it:
# APP_URL=https://vosonx.com/test
APP_URL=http://localhost:8080
APP_BASE=
APP_KEY=replace-with-a-long-random-string
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meridian
DB_USERNAME=meridian
DB_PASSWORD=change-me

# Set to true only if this server can send mail with PHP mail()
MAIL_ENABLED=false
